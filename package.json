{
  "name": "@ftes/publish-nextjs",
  "version": "0.1.0",
  "description": "Receive and publish FTES.AI articles on your Next.js site \u2014 route handler, Postgres adapter, and the SEO essentials.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fistasolutions/ftes-publish-nextjs.git"
  },
  "keywords": [
    "ftes",
    "nextjs",
    "publishing",
    "seo",
    "content",
    "webhook"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "import": "./dist/verify.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "next": "^16.0.7",
    "react": "^19.2.8",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18.17"
  }
}
